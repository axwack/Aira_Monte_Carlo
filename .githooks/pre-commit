#!/usr/bin/env bash
# Personal-data guard — blocks a commit when staged changes contain any
# pattern on the deny-list. Ships in the repo (.githooks/pre-commit) so
# every clone runs the same check.
#
# ONE-TIME PER CLONE: enable this hooks dir with
#     git config core.hooksPath .githooks
# (Windows GitBash / WSL / macOS / Linux all read it.)
#
# WHY THIS EXISTS
# ---------------
# `src/help/tax_treatment_by_account_type.html` leaked account structure,
# domicile, and Airbnb income into public git history for 3 commits before
# it was caught. Two test files also carried an exact DOB (`1970-03-14`).
# This hook blocks the same class of defect at commit time instead of after
# it ships. Bypass with `git commit --no-verify` only in an emergency —
# a bypass is invisible in the commit itself.
#
# HOW TO EXTEND
# -------------
# Add a pattern to DENY_PATTERNS below. Keep patterns narrow enough that
# they only match real leaks (`1970-03-14` yes, `1970` no).
#
# GOTCHA: filter-repo --replace-text will rewrite THIS FILE too. If you
# ever purge a new pattern from history with --replace-text, exclude this
# path so the DENY_PATTERNS list is not mutated into the exact pattern
# it was blocking:
#     git-filter-repo --replace-text <file> --path-glob '!.githooks/pre-commit'

set -e

# Only inspect ADDED lines in staged text changes. Deletions are fine;
# an existing leak the commit is REMOVING should not trip the guard.
# The hook itself is excluded: its DENY_PATTERNS list literally contains
# each blocked string, which would otherwise trip on every hook edit.
STAGED_DIFF=$(git diff --cached --diff-filter=ACM --no-color -U0 -- ':(exclude).githooks/pre-commit' || true)
[ -z "$STAGED_DIFF" ] && exit 0

# Deny-list. Extended-regex, case-insensitive. One alternation per rule so
# a match reports which one fired.
DENY_PATTERNS=(
  '1978-03-14'                # 
  '03/14/1970'                # s, US format
  '"Vincent Lee"'             # copyright name in string
  'Solo 401k'                 # personalised account label
  'axwacki|vincentplansfreedom'  # personal handles (funding-cfg only)
)

FAILED=0
for pattern in "${DENY_PATTERNS[@]}"; do
  # Grep only ADDED lines (+…) but not the +++ file header
  HITS=$(printf '%s\n' "$STAGED_DIFF" | grep -nE '^\+[^+]' | grep -iE "$pattern" || true)
  if [ -n "$HITS" ]; then
    if [ "$FAILED" -eq 0 ]; then
      echo ""
      echo "❌  pre-commit: personal-data guard tripped"
      echo ""
    fi
    echo "  Rule matched: $pattern"
    printf '%s\n' "$HITS" | sed 's/^/    /' | head -10
    echo ""
    FAILED=1
  fi
done

# .github/FUNDING.yml is the ONE place personal handles legitimately live.
# If the only trip was FUNDING.yml, allow it.
if [ "$FAILED" -eq 1 ]; then
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
  ONLY_FUNDING=$(printf '%s\n' "$STAGED_FILES" | grep -v '^\.github/FUNDING\.yml$' || true)
  if [ -z "$ONLY_FUNDING" ]; then
    echo "  (only .github/FUNDING.yml touched — allowed exception)"
    exit 0
  fi
  echo "  To bypass in an emergency: git commit --no-verify"
  echo "  Better: revise the change, or add a narrower pattern here if legitimate."
  exit 1
fi

exit 0
